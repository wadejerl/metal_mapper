# Template — install_pi_system.sh renders this to /etc/systemd/system/jlw_rover_rtk.service,
# filling the @MM_*@ placeholders from the checkout and install.conf;
# gnssntripclient comes from the venv the installer builds from requirements.txt.
[Unit]
Description=Rover RTK corrections to heading GPS (ttyUSB3)
After=multi-user.target
# never park in 'failed' from restart accounting: a field survey must
# survive the base rebooting or a USB re-enumeration without a hand restart
StartLimitIntervalSec=0
# A head unit without this GPS at boot skips the unit (inactive, dot off)
# instead of holding in the gate below forever (amber dot, and a
# foreground `systemctl restart` that never returns). The gate keeps its
# own device check for a USB re-enumeration mid-survey: conditions are
# evaluated at boot and on a manual start, not on Restart= relaunches.
ConditionPathExists=/dev/ttyUSB3

[Service]
# Gate the client on its preconditions actually being met: with no RTK base
# on the network, gnssntripclient exits after its retries and Restart=
# relaunched it every 2 s forever — the home-screen health dot flapped
# green/grey. This loop holds the unit in 'activating' (steady amber dot =
# honest: no corrections flowing) until the GPS is plugged in AND the
# caster answers, then starts the client (steady green). Pure bash /dev/tcp
# probe — no nc dependency on the Pi.
ExecStartPre=/bin/bash -c 'until [ -e /dev/ttyUSB3 ] && timeout 3 bash -c "</dev/tcp/@MM_BASE_HOST@/2101" 2>/dev/null; do sleep 10; done'
# the wait above is unbounded by design — NB a foreground `systemctl
# start/restart` of this unit therefore blocks until the gate passes; use
# `systemctl restart --no-block` when the base/GPS may be absent
TimeoutStartSec=infinity
ExecStart=/opt/metal_mapper/venv/bin/gnssntripclient --server @MM_BASE_HOST@ --port 2101 --mountpoint pygnssutils --clioutput 2 --output '/dev/ttyUSB3@460800' --verbosity 1  --retryinterval 1 --retries 3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
