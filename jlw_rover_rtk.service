[Unit]
Description=Rover RTK corrections to heading GPS (ttyUSB3)
After=multi-user.target
# never park in 'failed' from restart accounting: a field survey must
# survive the base rebooting or a USB re-enumeration without a hand restart
StartLimitIntervalSec=0

[Service]
# Gate the client on its preconditions actually being met: with no RTK base
# on the network, gnssntripclient exits after its retries and Restart=
# relaunched it every 2 s forever — the home-screen health dot flapped
# green/grey. This loop holds the unit in 'activating' (steady amber dot =
# honest: no corrections flowing) until the GPS is plugged in AND the
# caster answers, then starts the client (steady green). Pure bash /dev/tcp
# probe — no nc dependency on the Pi.
ExecStartPre=/bin/bash -c 'until [ -e /dev/ttyUSB3 ] && timeout 3 bash -c "</dev/tcp/northpole/2101" 2>/dev/null; do sleep 10; done'
# the wait above is unbounded by design — NB a foreground `systemctl
# start/restart` of this unit therefore blocks until the gate passes; use
# `systemctl restart --no-block` when the base/GPS may be absent
TimeoutStartSec=infinity
ExecStart=/home/pi/pygpsclient/bin/gnssntripclient --server northpole --port 2101 --mountpoint pygnssutils --clioutput 2 --output '/dev/ttyUSB3@460800' --verbosity 1  --retryinterval 1 --retries 3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
