# Template — install_pi_system.sh renders this to /etc/systemd/system/jlw_metalmap.service,
# filling the @MM_*@ placeholders from the checkout and install.conf.
[Unit]
Description=Metal Mapper Web UI
After=network.target

[Service]
User=@MM_USER@
Group=@MM_USER@
WorkingDirectory=/opt/metal_mapper
Environment="PATH=/opt/metal_mapper/venv/bin"
ExecStart=/opt/metal_mapper/venv/bin/gunicorn \
    --config /opt/metal_mapper/gunicorn_config.py \
    db_map:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
