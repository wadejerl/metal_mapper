# Template — install_pi_system.sh renders this to /etc/systemd/system/jlw_metalmap.service,
# filling the @MM_*@ placeholders from the checkout and install.conf.
[Unit]
Description=Metal Mapper Web UI
After=network.target

[Service]
User=@MM_USER@
Group=@MM_USER@
WorkingDirectory=/opt/metal_mapper
Environment="PATH=/opt/metal_mapper/venv/bin"
ExecStart=/opt/metal_mapper/venv/bin/gunicorn \
    --config /opt/metal_mapper/gunicorn_config.py \
    db_map:app
# gunicorn's built-in sd_notify sends READY=1 once its socket is bound —
# which is BEFORE it forks the worker that imports the app. Type=notify
# alone therefore made "active" mean "accepting connections nobody answers
# yet", and the kiosk ordered After= this unit still loaded into a backend
# that took its request and sat on it until nginx gave up (a white page,
# then nginx's error page). The probe below runs after READY=1 and holds
# the unit in "activating" until the worker actually answers /healthz (a
# route that touches nothing slow); After= dependents wait for that.
# Absolute paths: the unit's PATH is the venv only. Each probe gives up
# after 5 s (a request parked in the accept queue while the worker imports)
# and the loop retries; a worker that never answers trips TimeoutStartSec,
# the unit fails and Restart= tries again. Generous, so a slow SD card
# (chromium and the desktop loading off the same card) is waited out, not
# restarted into.
Type=notify
ExecStartPost=/bin/sh -c 'until /usr/bin/curl -fs -o /dev/null --max-time 5 http://127.0.0.1:8000/healthz; do /bin/sleep 1; done; echo "jlw_metalmap: worker answering /healthz"'
TimeoutStartSec=5min
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
